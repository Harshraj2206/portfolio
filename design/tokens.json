{
  "name": "Apple Liquid Glass Design Tokens",
  "version": "1.0.0",
  "theme": {
    "light": {
      "background": {
        "surface": "rgba(255, 255, 255, 0.55)",
        "surfaceHover": "rgba(255, 255, 255, 0.70)",
        "solidFallback": "#F5F5F7",
        "mesh": [
          "#E0ECFF",
          "#EDE9FE",
          "#FCE7F3",
          "#E6FFFA"
        ]
      },
      "border": {
        "subtle": "rgba(255, 255, 255, 0.45)",
        "highlightTop": "inset 0 1px 0 rgba(255, 255, 255, 0.65)"
      },
      "text": {
        "primary": "#1D1D1F",
        "secondary": "#6E6E73",
        "tertiary": "#86868B"
      },
      "shadow": {
        "card": "0 8px 32px rgba(0, 0, 0, 0.08), 0 1px 2px rgba(0, 0, 0, 0.04)",
        "glow": "0 0 20px rgba(10, 132, 255, 0.25)"
      }
    },
    "dark": {
      "background": {
        "surface": "rgba(28, 28, 30, 0.55)",
        "surfaceHover": "rgba(44, 44, 46, 0.70)",
        "solidFallback": "#161618",
        "mesh": [
          "#0B0F19",
          "#111827",
          "#1E1B4B",
          "#0F172A"
        ]
      },
      "border": {
        "subtle": "rgba(255, 255, 255, 0.12)",
        "highlightTop": "inset 0 1px 0 rgba(255, 255, 255, 0.18)"
      },
      "text": {
        "primary": "#F5F5F7",
        "secondary": "#A1A1A6",
        "tertiary": "#6E6E73"
      },
      "shadow": {
        "card": "0 8px 32px rgba(0, 0, 0, 0.40), 0 1px 2px rgba(0, 0, 0, 0.25)",
        "glow": "0 0 24px rgba(10, 132, 255, 0.35)"
      }
    }
  },
  "colors": {
    "systemBlue": "#0A84FF",
    "systemPurple": "#AF52DE",
    "systemTeal": "#30B0C7",
    "systemPink": "#FF375F",
    "systemGreen": "#34C759",
    "systemYellow": "#FFD60A"
  },
  "typography": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"SF Pro Text\", \"Helvetica Neue\", Inter, sans-serif",
    "scale": {
      "hero": {
        "size": "72px",
        "weight": "700",
        "tracking": "-0.03em",
        "lineHeight": "1.05"
      },
      "h1": {
        "size": "56px",
        "weight": "700",
        "tracking": "-0.025em",
        "lineHeight": "1.1"
      },
      "h2": {
        "size": "40px",
        "weight": "600",
        "tracking": "-0.02em",
        "lineHeight": "1.15"
      },
      "h3": {
        "size": "24px",
        "weight": "600",
        "tracking": "-0.015em",
        "lineHeight": "1.25"
      },
      "body": {
        "size": "17px",
        "weight": "400",
        "tracking": "-0.01em",
        "lineHeight": "1.47"
      },
      "callout": {
        "size": "15px",
        "weight": "500",
        "tracking": "-0.005em",
        "lineHeight": "1.4"
      },
      "caption": {
        "size": "13px",
        "weight": "400",
        "tracking": "0em",
        "lineHeight": "1.35"
      }
    }
  },
  "radii": {
    "pill": "9999px",
    "panel": "36px",
    "card": "28px",
    "chip": "14px",
    "control": "10px"
  },
  "blur": {
    "glass": "blur(24px) saturate(180%)",
    "heavy": "blur(40px) saturate(200%)"
  },
  "motion": {
    "springEasing": "cubic-bezier(0.22, 1, 0.36, 1)",
    "duration": "350ms"
  }
}